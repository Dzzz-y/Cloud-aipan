```gitignore
# ====================
# 全局忽略
# ====================

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# 日志文件
*.log
app-log
logs/

# 临时文件
*.tmp
*.bak
*.swp
*~

# ====================
# Java / Maven
# ====================
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# ====================
# Python
# ====================
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
myenv/
venv/
.venv/
.env
*.egg

# ====================
# Node.js
# ====================
node_modules/
npm-debug.log*
package-lock.json

# ====================
# 敏感配置文件（重要！）
# ====================
backend/src/main/resources/application.yaml
ai-agent/.env

# ====================
# 上传/临时文件
# ====================
upload/
temp/
tmp/
```